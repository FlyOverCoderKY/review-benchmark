{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.flyovercoder.com/schemas/task-v2.schema.json",
  "title": "Review Benchmark Task v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "title",
    "family_id",
    "origin",
    "visibility",
    "source",
    "files",
    "context",
    "coverage",
    "version_context",
    "lifecycle"
  ],
  "properties": {
    "schema": {"const": "review-benchmark/task/2"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "family_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "origin": {
      "enum": [
        "planted",
        "clean-control",
        "human-review",
        "production-escape",
        "fresh-mutation",
        "partner-unpublished"
      ]
    },
    "visibility": {"enum": ["public", "private"]},
    "source": {"type": "object"},
    "files": {"$ref": "#/$defs/files"},
    "context": {"type": "object"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "version_context": {"$ref": "#/$defs/version_context"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "identifier_array": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/@<>=~^,* -]*[A-Za-z0-9._+:/@<>=~^,*]$|^[A-Za-z0-9]$"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diff", "checkout", "gold"],
      "properties": {
        "diff": {"type": "string", "minLength": 1},
        "checkout": {"type": "string", "minLength": 1},
        "gold": {"type": "string", "minLength": 1},
        "adjudications": {"type": "string", "minLength": 1}
      }
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "ecosystem"],
      "properties": {
        "language": {"$ref": "#/$defs/identifier"},
        "ecosystem": {"$ref": "#/$defs/identifier"}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "databases", "providers"],
      "properties": {
        "layers": {"$ref": "#/$defs/identifier_array"},
        "databases": {"$ref": "#/$defs/identifier_array"},
        "providers": {"$ref": "#/$defs/identifier_array"}
      }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "services"],
      "properties": {
        "provider": {"$ref": "#/$defs/identifier"},
        "services": {"$ref": "#/$defs/identifier_array"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary_languages",
        "frameworks",
        "libraries",
        "data",
        "cloud",
        "artifacts",
        "tracks",
        "surfaces"
      ],
      "properties": {
        "primary": {"$ref": "#/$defs/primary"},
        "secondary_languages": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "frameworks": {"$ref": "#/$defs/identifier_array"},
        "libraries": {"$ref": "#/$defs/identifier_array"},
        "data": {"$ref": "#/$defs/data"},
        "cloud": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/cloud"}
        },
        "artifacts": {"$ref": "#/$defs/identifier_array", "minItems": 1},
        "tracks": {"$ref": "#/$defs/identifier_array", "minItems": 1},
        "surfaces": {"$ref": "#/$defs/identifier_array"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "as_of"],
      "properties": {
        "state": {"$ref": "#/$defs/identifier"},
        "as_of": {"$ref": "#/$defs/date"}
      }
    },
    "version_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of"],
      "properties": {
        "source": {"$ref": "#/$defs/identifier"},
        "target": {"$ref": "#/$defs/identifier"},
        "as_of": {"$ref": "#/$defs/date"}
      },
      "anyOf": [
        {"required": ["source"]},
        {"required": ["target"]}
      ]
    },
    "version_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "source", "target"],
      "properties": {
        "kind": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/version"},
        "target": {"$ref": "#/$defs/version"},
        "lifecycle": {"$ref": "#/$defs/version_lifecycle"}
      }
    },
    "version_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "components"],
      "properties": {
        "as_of": {"$ref": "#/$defs/date"},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/version_component"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.flyovercoder.com/schemas/semantic-conformance-labels.schema.json",
  "title": "Blinded Semantic Conformance Labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "label_set_id",
    "corpus_id",
    "corpus_sha256",
    "kind",
    "status",
    "reviewer_id",
    "groups"
  ],
  "properties": {
    "schema": {"const": "review-benchmark/semantic-conformance-labels/1"},
    "label_set_id": {"$ref": "#/$defs/id"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "kind": {"enum": ["independent", "adjudicated"]},
    "status": {"enum": ["in-progress", "complete"]},
    "reviewer_id": {"$ref": "#/$defs/id"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/group"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "line", "severity", "title", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "severity": {"enum": ["bug", "risk", "nit"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "reference_findings", "candidate_findings", "pairs"],
      "properties": {
        "group_id": {"$ref": "#/$defs/id"},
        "reference_findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/finding"}
        },
        "candidate_findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/finding"}
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pair_id", "reference_id", "candidate_id", "verdict", "rationale"],
            "properties": {
              "pair_id": {"$ref": "#/$defs/id"},
              "reference_id": {"$ref": "#/$defs/id"},
              "candidate_id": {"$ref": "#/$defs/id"},
              "verdict": {
                "type": ["string", "null"],
                "enum": ["match", "no-match", "insufficient-evidence", null]
              },
              "rationale": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {
        "properties": {
          "groups": {
            "items": {
              "properties": {
                "pairs": {
                  "items": {
                    "properties": {
                      "verdict": {"enum": ["match", "no-match", "insufficient-evidence"]},
                      "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.flyovercoder.com/schemas/release-v2.schema.json",
  "title": "Immutable Official Benchmark Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "release_id", "visibility", "status",
    "public_benchmark_revision", "tasks", "artifacts"
  ],
  "properties": {
    "schema": {"const": "review-benchmark/release/2"},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "visibility": {"enum": ["public", "private"]},
    "status": {"const": "official"},
    "public_benchmark_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "task_id", "task_manifest_sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "task_manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 1000000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?![^/]*:)[^\\u0000-\\u001f\\u007f/\\\\]+(?:/[^\\u0000-\\u001f\\u007f/\\\\]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bench.flyovercoder.com/schemas/semantic-matcher-decisions.schema.json",
  "title": "Semantic Matcher Pair Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_set_id", "corpus_id", "corpus_sha256", "matcher", "decisions"],
  "properties": {
    "schema": {"const": "review-benchmark/semantic-matcher-decisions/1"},
    "decision_set_id": {"$ref": "#/$defs/id"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "verdict"],
        "properties": {
          "pair_id": {"$ref": "#/$defs/id"},
          "verdict": {"enum": ["match", "no-match"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
